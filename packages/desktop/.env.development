# Loaded automatically by Bun for `bun run tauri dev`; shell variables still win.
#
# WebKitGTK resolves proxies through GLib, which honours http_proxy/https_proxy
# for *every* host — including the Vite dev server. Behind a proxy the webview
# navigation to the dev URL is routed upstream, fails, and the window renders an
# empty document with no console output and no network entries. Browsers hide
# this because they bypass proxies for loopback on their own.
no_proxy=localhost,127.0.0.1,::1
NO_PROXY=localhost,127.0.0.1,::1
