{
  "name": "@oh-my-pi/desktop",
  "version": "17.2.15",
  "private": true,
  "type": "module",
  "description": "Native desktop presentation for Oh My Pi",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "biome check . && bun run check:types",
    "check:types": "tsgo -p tsconfig.json --noEmit",
